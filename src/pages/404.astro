---
import PageLayout from '@/layouts/BaseLayout.astro'
import { localizedPath } from '@/i18n/routing'
import { getPublishedResearch } from '@/utils/research'

const availableResearch = Object.fromEntries(
	(await getPublishedResearch()).map((entry) => [
		`${entry.data.locale}/${entry.data.id}`,
		localizedPath(entry.data.locale, 'research-detail', entry.data.id)
	])
)
const base = import.meta.env.BASE_URL
---

<PageLayout meta={{ title: '404', description: 'La página solicitada no existe. Page not found.' }}>
	<div class='w-full px-4 py-16 text-center'>
		<h1 class='text-7xl font-semibold sm:text-9xl'>404</h1>
		<p class='mt-6 text-lg'>
			No encontramos esta página. <span lang='en'>This page was not found.</span>
		</p>
		<p class='mt-6'>
			<a id='available-translation' class='hidden underline underline-offset-4'></a>
		</p>
		<div class='mt-6 flex flex-wrap justify-center gap-6'>
			<a class='underline underline-offset-4' href={localizedPath('es', 'home')}
				>Inicio en español</a
			>
			<a class='underline underline-offset-4' href={localizedPath('en', 'home')} lang='en'
				>English home</a
			>
		</div>
	</div>
</PageLayout>

<script is:inline define:vars={{ availableResearch, base }}>
	const path = window.location.pathname
	const relative = path.startsWith(base) ? path.slice(base.length) : ''
	const match = relative.match(/^(es|en)\/research\/([a-z0-9-]+)\/?$/)
	if (match) {
		const [, requested, id] = match
		const other = requested === 'es' ? 'en' : 'es'
		const href = availableResearch[`${other}/${id}`]
		if (href) {
			const link = document.getElementById('available-translation')
			link.href = href
			link.lang = other
			link.textContent =
				other === 'es'
					? 'Ver la versión disponible en español'
					: 'View the available English version'
			link.classList.remove('hidden')
		}
	}
</script>
