---
import '@/styles/site.css'
import BaseHead from '@/components/BaseHead.astro'
import LocalePreference from '@/components/navigation/LocalePreference.astro'
import { alternatePaths, localizedPath } from '@/i18n/routing'
import { profile } from '@/data/profile'
import { ui } from '@/i18n/ui'

const alternates = alternatePaths('home')
---

<!doctype html>
<html lang='es'>
	<head>
		<LocalePreference redirectHome />
		<BaseHead
			title={profile.name}
			description='Investigación, biología y computación. Research, biology, and computing.'
			alternates={alternates}
			xDefault
			themeColor='#070a09'
		/>
	</head>
	<body class='new-site language-gate'>
		<a class='skip-link' href='#content'>Saltar al contenido / Skip to content</a>
		<header class='site-container gate-header'>
			<span class='site-brand' aria-label={profile.creditName}
				>{profile.creditName.slice(0, -1)}<span>.</span></span
			>
		</header>
		<main id='content' class='site-container gate-content'>
			<p class='eyebrow'>{profile.name} / oquinterol.com</p>
			<h1>{ui.es.selectLanguage} <span lang='en'>/ {ui.en.selectLanguage}</span></h1>
			<p>{ui.es.languageHint}</p>
			<p lang='en'>{ui.en.languageHint}</p>
			<div class='gate-choices'>
				<a href={localizedPath('es', 'home')} lang='es' data-language-choice='es'>
					<span class='gate-code'>ES <span aria-hidden='true'>↗</span></span>
					<span>Español</span>
					<small class='gate-suggestion' data-suggestion='es' hidden>Idioma sugerido</small>
				</a>
				<a href={localizedPath('en', 'home')} lang='en' data-language-choice='en'>
					<span class='gate-code'>EN <span aria-hidden='true'>↗</span></span>
					<span>English</span>
					<small class='gate-suggestion' data-suggestion='en' hidden>Suggested language</small>
				</a>
			</div>
		</main>
		<footer class='site-container gate-footer'>
			Biología · Computación · Sistemas <span lang='en'>/ Biology · Computing · Systems</span>
		</footer>
		<script>
			// A suggestion is not a stored choice: first-time visitors still choose themselves.
			const browser = navigator.languages?.find((language) => /^(es|en)(-|$)/i.test(language))
			const preferred = browser?.toLowerCase().startsWith('en') ? 'en' : 'es'
			const suggestion = document.querySelector<HTMLElement>(`[data-suggestion="${preferred}"]`)
			if (suggestion) suggestion.hidden = false
		</script>
	</body>
</html>
