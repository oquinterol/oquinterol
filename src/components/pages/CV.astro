---
import LocalizedLayout from '@/layouts/LocalizedLayout.astro'
import SkillsPanel from '@/components/pages/SkillsPanel.astro'
import { education, profile } from '@/data/profile'
import { ui, type Locale } from '@/i18n/ui'

interface Props {
	locale: Locale
}
const { locale } = Astro.props
const copy = ui[locale].cv
const otherLocale = locale === 'es' ? 'en' : 'es'
---

<LocalizedLayout locale={locale} page='cv' title={copy.label} description={copy.intro}>
	<div class='site-container page-content'>
		<div class='page-heading'>
			<div>
				<p class='eyebrow'>{copy.label}</p>
				<h1>{profile.name}</h1>
				<p class='lead'>{copy.bio}</p>
				<p class='site-muted'>{profile.location}</p>
			</div>
		</div>

		<div class='cv-downloads'>
			<a class='text-link' href={profile.cvPdf[locale]}
				>{copy.download} <span aria-hidden='true'>↗</span></a
			>
			<a href={profile.cvPdf[otherLocale]} lang={otherLocale}>
				{otherLocale === 'es' ? ui.es.cv.download : ui.en.cv.download}
				<span aria-hidden='true'>↗</span>
			</a>
		</div>

		<section class='editorial-section' aria-labelledby='education-title'>
			<div class='section-heading'>
				<p class='eyebrow'>01</p><div><h2 id='education-title'>{copy.education}</h2></div>
			</div>
			<ul class='cv-education'>
				{
					education.map((degree) => (
						<li>
							<>
								<h3>{degree[locale]}</h3>
								<p>{degree.institution}</p>
							</>
						</li>
					))
				}
			</ul>
		</section>

		<section class='editorial-section' aria-labelledby='areas-title'>
			<div class='section-heading'>
				<p class='eyebrow'>02</p><div><h2 id='areas-title'>{copy.areas}</h2></div>
			</div>
			<SkillsPanel locale={locale} />
		</section>

		<section class='editorial-section' aria-labelledby='links-title'>
			<div class='section-heading'>
				<p class='eyebrow'>03</p><div><h2 id='links-title'>{copy.links}</h2></div>
			</div>
			<ul class='cv-links'>
				<li><a href={`mailto:${profile.email}`}>{copy.contact}: {profile.email}</a></li>
				<li><a href={profile.links.github}>GitHub <span aria-hidden='true'>↗</span></a></li>
				<li><a href={profile.links.linkedin}>LinkedIn <span aria-hidden='true'>↗</span></a></li>
				<li><a href={profile.links.orcid}>ORCID <span aria-hidden='true'>↗</span></a></li>
			</ul>
		</section>
	</div>
</LocalizedLayout>
