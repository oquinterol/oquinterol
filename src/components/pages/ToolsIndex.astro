---
import LocalizedLayout from '@/layouts/LocalizedLayout.astro'
import { localizedPath } from '@/i18n/routing'
import { ui, type Locale } from '@/i18n/ui'

interface Props {
	locale: Locale
}
const { locale } = Astro.props
const copy = ui[locale].tools
---

<LocalizedLayout locale={locale} page='tools' title={copy.label} description={copy.intro}>
	<div class='site-container page-content'>
		<div class='page-heading'>
			<p class='eyebrow'>{copy.label}</p>
			<h1>{copy.intro}</h1>
		</div>
		<ul class='research-list'>
			<li>
				<article>
					<p class='eyebrow'>{copy.status} · MIT</p>
					<h2>
						<a href={localizedPath(locale, 'vector-editor')}>{copy.vectorEditor.title}</a>
					</h2>
					<p>{copy.vectorEditor.summary}</p>
					<a class='text-link' href={localizedPath(locale, 'vector-editor')}>
						{copy.open}
						<span aria-hidden='true'>↗</span>
					</a>
					<a class='text-link secondary-link' href={copy.vectorEditor.repository}>
						{copy.code}
						<span aria-hidden='true'>↗</span>
					</a>
				</article>
			</li>
		</ul>
	</div>
</LocalizedLayout>
