---
import LocalizedLayout from '@/layouts/LocalizedLayout.astro'
import VectorEditorIsland from '@/components/visualizations/VectorEditorIsland'
import { localizedPath } from '@/i18n/routing'
import { ui, type Locale } from '@/i18n/ui'

interface Props {
	locale: Locale
}
const { locale } = Astro.props
const copy = ui[locale].tools
---

<LocalizedLayout
	locale={locale}
	page='vector-editor'
	title={copy.vectorEditor.title}
	description={copy.vectorEditor.summary}
>
	<div class='site-container page-content tool-page'>
		<a class='text-link back-link' href={localizedPath(locale, 'tools')}>← {copy.label}</a>
		<div class='page-heading'>
			<p class='eyebrow'>{copy.label} · {copy.status}</p>
			<h1>{copy.vectorEditor.title}</h1>
			<p class='lead'>{copy.vectorEditor.summary}</p>
			<a class='text-link' href={copy.vectorEditor.repository}>
				{copy.code}
				<span aria-hidden='true'>↗</span>
			</a>
		</div>
		<VectorEditorIsland locale={locale} client:only='react'>
			<p slot='fallback' class='lead'>{copy.vectorEditor.noscript}</p>
		</VectorEditorIsland>
	</div>
</LocalizedLayout>
