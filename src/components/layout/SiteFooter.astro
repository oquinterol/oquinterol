---
import { profile } from '@/data/profile'
import type { Locale } from '@/i18n/ui'
import { ui } from '@/i18n/ui'

interface Props {
	locale: Locale
}
const { locale } = Astro.props
---

<footer class='site-footer'>
	<div class='site-container footer-inner'>
		<div>
			<p class='footer-name'>{profile.name}</p>
			<p class='site-muted'>{ui[locale].footer}</p>
		</div>
		<ul
			class='footer-links'
			aria-label={locale === 'es' ? 'Enlaces profesionales' : 'Professional links'}
		>
			<li><a href={`mailto:${profile.email}`}>{locale === 'es' ? 'Correo' : 'Email'}</a></li>
			<li><a href={profile.links.github}>GitHub</a></li>
			<li><a href={profile.links.linkedin}>LinkedIn</a></li>
			<li><a href={profile.links.orcid}>ORCID</a></li>
		</ul>
	</div>
</footer>
