---
// Import the global.css file here so that it is included on
// all pages through the use of the <BaseHead /> component.
import '../styles/app.css'

import type { SiteMeta } from '@/types'
import type { Locale } from '@/i18n/ui'
import { siteConfig } from '@/site-config'

type Props = SiteMeta & {
	locale?: Locale
	alternates?: Array<{ locale: Locale; path: string }>
	xDefault?: boolean
	themeColor?: string
}

const {
	articleDate,
	description,
	ogImage,
	title,
	locale,
	alternates = [],
	xDefault = false,
	themeColor = '#faf9f6'
} = Astro.props

const titleSeparator = '•'
const siteTitle =
	title === siteConfig.title ? title : `${title} ${titleSeparator} ${siteConfig.title}`
const canonicalURL = new URL(Astro.url.pathname, Astro.site)
const base = import.meta.env.BASE_URL
const socialImageURL = new URL(ogImage ?? `${base}social-card.png`, Astro.site).href
---

<meta charset='utf-8' />
<meta content='width=device-width, initial-scale=1.0, shrink-to-fit=no' name='viewport' />
<meta content='IE=edge' http-equiv='X-UA-Compatible' />
<title>{siteTitle}</title>

<link rel='apple-touch-icon' sizes='180x180' href={`${base}favicon/apple-touch-icon.png`} />
<link rel='icon' type='image/png' sizes='32x32' href={`${base}favicon/favicon-32x32.png`} />
<link rel='icon' type='image/png' sizes='16x16' href={`${base}favicon/favicon-16x16.png`} />
<link rel='manifest' href={`${base}favicon/site.webmanifest`} />

{/* Canonical URL */}
<link rel='canonical' href={canonicalURL} />
{
	alternates.map(({ locale: alternateLocale, path }) => (
		<link
			rel='alternate'
			hreflang={alternateLocale === 'es' ? 'es-CO' : 'en'}
			href={new URL(path, Astro.site)}
		/>
	))
}
{
	xDefault && (
		<link
			rel='alternate'
			hreflang='x-default'
			href={new URL(import.meta.env.BASE_URL, Astro.site)}
		/>
	)
}

{/* Primary Meta Tags */}
<meta content={siteTitle} name='title' />
<meta content={description} name='description' />
<meta content={siteConfig.author} name='author' />

{/* Theme Colour */}
<meta content={themeColor} name='theme-color' />

{/* Open Graph / Facebook */}
<meta content={articleDate ? 'article' : 'website'} property='og:type' />
<meta content={title} property='og:title' />
<meta content={description} property='og:description' />
<meta content={canonicalURL} property='og:url' />
<meta content={siteConfig.title} property='og:site_name' />
<meta content={locale === 'en' ? 'en_US' : siteConfig.ogLocale} property='og:locale' />
{
	alternates
		.filter((alternate) => alternate.locale !== locale)
		.map((alternate) => (
			<meta
				content={alternate.locale === 'es' ? 'es_CO' : 'en_US'}
				property='og:locale:alternate'
			/>
		))
}
<meta content={socialImageURL} property='og:image' />
<meta content='1200' property='og:image:width' />
<meta content='630' property='og:image:height' />
{
	articleDate && (
		<>
			<meta content={siteConfig.author} property='article:author' />
			<meta content={articleDate} property='article:published_time' />
		</>
	)
}

{/* Twitter */}
<meta content='summary_large_image' property='twitter:card' />
<meta content={canonicalURL} property='twitter:url' />
<meta content={title} property='twitter:title' />
<meta content={description} property='twitter:description' />
<meta content={socialImageURL} property='twitter:image' />

{/* Sitemap */}
<link href={`${base}sitemap-index.xml`} rel='sitemap' />

{/* RSS auto-discovery */}
<link href={`${base}rss.xml`} rel='alternate' title={siteConfig.title} type='application/rss+xml' />

<meta content={Astro.generator} name='generator' />
