---
import '@/styles/site.css'
import '@/styles/adaptive-diagrams.css'
import type { Locale } from '@/i18n/ui'
import type { Page } from '@/i18n/routing'
import { alternatePaths } from '@/i18n/routing'
import BaseHead from '@/components/BaseHead.astro'
import SiteHeader from '@/components/layout/SiteHeader.astro'
import SiteFooter from '@/components/layout/SiteFooter.astro'
import LocalePreference from '@/components/navigation/LocalePreference.astro'

interface Props {
	locale: Locale
	page: Page
	id?: string
	title: string
	description: string
	availableLocales?: Locale[]
}

const { locale, page, id, title, description, availableLocales } = Astro.props
const alternates = alternatePaths(page, id, availableLocales)
---

<!doctype html>
<html lang={locale === 'es' ? 'es-CO' : 'en'}>
	<head>
		<LocalePreference />
		<BaseHead
			title={title}
			description={description}
			locale={locale}
			alternates={alternates}
			xDefault={page === 'home'}
			themeColor='#070a09'
		/>
	</head>
	<body class='new-site'>
		<a class='skip-link' href='#content'
			>{locale === 'es' ? 'Saltar al contenido' : 'Skip to content'}</a
		>
		<SiteHeader locale={locale} page={page} alternates={alternates} />
		<main id='content' class='site-main'><slot /></main>
		<SiteFooter locale={locale} />
	</body>
</html>
